---
import type { Lang } from '../consts';
import { SITE, LANG_LOCALES } from '../consts';
import { ROUTES, t } from '../i18n/ui';
import type { Article } from '../data/articles';
import BaseLayout from './BaseLayout.astro';

export interface Props {
  lang: Lang;
  article: Article;
}
const { lang, article } = Astro.props;
const content = article.content[lang];

// Translations map for hreflang
const translations: Partial<Record<Lang, string>> = {
  fr: `${ROUTES.fr.decryptages}/${article.slug}`,
  en: `${ROUTES.en.decryptages}/${article.slug}`,
  es: `${ROUTES.es.decryptages}/${article.slug}`,
  zh: `${ROUTES.zh.decryptages}/${article.slug}`,
};

// JSON-LD MedicalScholarlyArticle
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalScholarlyArticle',
  headline: content.title,
  description: content.description,
  datePublished: article.date,
  dateModified: article.updated,
  inLanguage: LANG_LOCALES[lang],
  author: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon/android-512.png` },
  },
  citation: {
    '@type': 'MedicalScholarlyArticle',
    headline: article.originalTitle,
    url: article.originalUrl,
    identifier: article.originalDoi,
    publisher: { '@type': 'Organization', name: article.originalJournal },
  },
  about: [
    ...(article.drugs ?? []).map((d) => ({
      '@type': 'Drug',
      name: d.name,
      ...(d.sameAs ? { sameAs: d.sameAs } : {}),
    })),
    ...(article.conditions ?? []).map((c) => ({
      '@type': 'MedicalCondition',
      name: c.name,
      ...(c.sameAs ? { sameAs: c.sameAs } : {}),
    })),
  ],
  audience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
  isAccessibleForFree: true,
  mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(Astro.url.pathname, SITE.url).toString() },
};

const formattedDate = new Date(article.date).toLocaleDateString(lang, {
  day: 'numeric', month: 'long', year: 'numeric',
});
---

<BaseLayout
  lang={lang}
  title={content.title}
  description={content.description}
  translations={translations}
  jsonLd={[JSON.stringify(articleSchema)]}
>
  <article class="prose article-body">
    <header class="article-header">
      <div class="article-tags">
        {article.tags.includes('medical') && <span class="tag tag-medical">médical</span>}
        {article.tags.includes('ai') && <span class="tag tag-ai">IA</span>}
      </div>
      <h1>{content.title}</h1>
      <div class="article-meta">
        <span>{t(lang, 'article.published')} {formattedDate}</span>
        <span class="dot">·</span>
        <span>{article.readTime} {t(lang, 'article.minutes')} {t(lang, 'article.read_time')}</span>
      </div>
    </header>

    <Fragment set:html={content.body} />

    <hr />

    <aside class="article-source">
      <div class="label-meta">{t(lang, 'article.original')}</div>
      <a href={article.originalUrl} target="_blank" rel="noopener noreferrer">
        {article.originalTitle}
      </a>
      <div class="article-source-meta">
        <em>{article.originalJournal}</em> · DOI: <code>{article.originalDoi}</code>
      </div>
    </aside>

  </article>
</BaseLayout>

<style>
  .article-body { padding-top: 32px; padding-bottom: 32px; }
  .article-header { margin-bottom: 32px; }
  .article-tags { margin-bottom: 16px; }
  .article-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-mute);
    margin-top: 12px;
  }
  .article-meta .dot { margin: 0 8px; opacity: 0.5; }
  :global(.lede) {
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--text);
    border-left: 3px solid var(--pulse);
    padding: 6px 22px;
    margin: 24px 0 28px;
    background: white;
    border-radius: 0 8px 8px 0;
  }
  .article-source {
    background: white;
    border: 0.5px solid var(--border);
    border-radius: 10px;
    padding: 18px 22px;
    margin: 28px 0;
  }
  .article-source .label-meta { margin-bottom: 6px; }
  .article-source a {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    text-decoration-color: var(--pulse);
  }
  .article-source-meta {
    font-size: 12px;
    color: var(--text-mute);
    margin-top: 6px;
  }
</style>

---
import type { Lang } from '../consts';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  href: string;
  title: string;
  description: string;
  date: string;
  author: string;
  readTime?: number;
  tags?: ('ai' | 'medical')[];
}
const { lang, href, title, description, date, author, readTime, tags = [] } = Astro.props;
---
<a href={href} class="card unstyled">
  <div class="card-meta">
    <span class="label-meta">{new Date(date).toLocaleDateString(lang, { day: 'numeric', month: 'long', year: 'numeric' })}</span>
    <span class="card-author">· {author}</span>
    {readTime && <span class="card-read"> · {readTime} {t(lang, 'article.minutes')}</span>}
  </div>
  <h3 class="card-title">{title}</h3>
  <p class="card-desc">{description}</p>
  <div class="card-tags">
    {tags.includes('medical') && <span class="tag tag-medical">médical</span>}
    {tags.includes('ai') && <span class="tag tag-ai">IA</span>}
    <span class="card-read-more">{t(lang, 'home.read_more')} →</span>
  </div>
</a>

<style>
  .card {
    display: block;
    background: white;
    border: 0.5px solid var(--border);
    border-radius: 12px;
    padding: 24px 28px;
    transition: transform 0.15s, border-color 0.15s;
  }
  .card:hover { transform: translateY(-2px); border-color: var(--pulse); }
  .card-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-mute);
    letter-spacing: 0.5px;
    margin-bottom: 6px;
  }
  .card-author { color: var(--text-soft); }
  .card-read { opacity: 0.65; }
  .card-title {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    margin: 4px 0 8px;
    letter-spacing: -0.3px;
  }
  .card-desc {
    color: var(--text-soft);
    font-size: 0.95rem;
    margin: 0 0 16px;
  }
  .card-tags {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
  }
  .card-read-more {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--pulse);
  }
</style>
